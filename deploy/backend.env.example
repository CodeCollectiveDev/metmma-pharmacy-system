# Install as /opt/metmma/backend.env, mode 0600. No quotes around values (raw env file).
NODE_ENV=production
PORT=3000
JWT_SECRET=
# Direct Neon URL, WITHOUT sslmode/channel_binding query parameters.
# DB_SSL below enables certificate verification in node-postgres.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@ep-example.region.aws.neon.tech/neondb
MIGRATION_DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@ep-example.region.aws.neon.tech/neondb
DB_SSL=true
ALLOWED_ORIGINS=https://your-frontend.vercel.app
TRUST_PROXY=1
TAX_RATE_BPS=1650
# Keep UTC for existing data unless historical timestamp semantics have been checked.
PHARMACY_TIMEZONE=UTC
