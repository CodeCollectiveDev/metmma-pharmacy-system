# Install as /opt/metmma/backup.env, mode 0600. No quotes around values.
# Direct (not -pooler) Neon URL, WITHOUT query parameters. Script enforces verified TLS.
BACKUP_DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@ep-example.region.aws.neon.tech/neondb
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=metmma-backups
R2_PREFIX=metmma/production
# Bucket-scoped R2 Object Read & Write credentials.
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
