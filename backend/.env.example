# Copy to .env and supply real values. Never commit .env.
NODE_ENV=production
PORT=3000
JWT_SECRET=
# Use DATABASE_URL or individual DB_* fields. URL should not contain sslmode when DB_SSL_CA is provided.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metmma_pharmacy
DB_USER=metmma_user
DB_PASSWORD=
# true for hosted PostgreSQL; validates the server certificate. false for local DB.
DB_SSL=true
# Optional PEM CA for a provider using a private certificate authority.
DB_SSL_CA=
ALLOWED_ORIGINS=https://your-pharmacy.example
# Set only for a known reverse proxy topology (Render uses one trusted hop).
TRUST_PROXY=1
# Preserve uploaded behavior: 16.5% VAT. Confirm applicable rate before release.
TAX_RATE_BPS=1650
# Africa/Blantyre for Malawi. Keep existing DB timestamps consistent; see release checklist.
PHARMACY_TIMEZONE=UTC
