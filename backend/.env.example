# METMMA Pharmacy System - Environment Variables
# Copy this file to .env and fill in your values
# For Render: set these in the Render dashboard under "Environment"

# --- Database (Neon) ---
# Use your Neon connection string OR individual fields below
# Get it from: https://neon.tech → your project → Connect → Connection String
DATABASE_URL=postgresql://username:password@hostname:port/database?sslmode=require

# --- OR use individual DB fields (if not using DATABASE_URL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metmma_pharmacy
DB_USER=metmma_user
DB_PASSWORD=your-secure-password

# --- Server ---
PORT=3000
NODE_ENV=production

# --- JWT Secret (REQUIRED, min 32 chars) ---
# The server refuses to start (fail fast) without it. There is NO fallback
# secret — a hardcoded fallback would allow token forgery if misconfigured.
# Generate: openssl rand -hex 32  (Linux/Mac)
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars

# --- Token lifetimes (optional) ---
# Access tokens are short-lived; the client silently refreshes them.
ACCESS_TOKEN_TTL=15m
# Refresh token / session lifetime.
REFRESH_TOKEN_TTL=7d

# --- CORS (your Netlify URL) ---
# Comma-separated if multiple origins
ALLOWED_ORIGINS=https://your-frontend.netlify.app
