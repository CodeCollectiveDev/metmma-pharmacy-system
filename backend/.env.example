# Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=metmma_pharmacy
DB_PASSWORD=
DB_PORT=5432

# JWT
JWT_SECRET=your_secret_here

# Thermal Receipt Printer
# Connection type: 'network' (TCP/IP) or 'usb'/'system' (OS printer / CUPS driver)
PRINTER_TYPE=network
# Type: 'network' -> IP/hostname of the printer
PRINTER_HOST=192.168.1.100
# Type: 'network' -> raw ESC/POS port (9100 is standard)
PRINTER_PORT=9100
# Type: 'usb'/'system' -> system printer name, e.g. 'printer:POS58' or 'printer:TM-T20X'
PRINTER_INTERFACE=printer:POS58
# Type: 'usb'/'system' -> printer driver; 'epson' is the common default
PRINTER_DRIVER=epson
# Receipt text width in characters (58mm paper = 32-42, 80mm paper = 42-48)
PRINTER_WIDTH=42

# Pharmacy name shown on the thermal receipt
PHARMACY_NAME=METMMA Pharmacy